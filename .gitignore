# Lazarus / FPC build artifacts
lib/
backup/

# Python bytecode cache (tools/make-icon.py)
__pycache__/

# installer staging + output (see .github/workflows/package.yml)
dist/
build/
*.o
*.ppu
*.compiled
*.or
*.dbg
*.lps
gotbox
gotbox.exe
gotbox.app/
gotboxd
gotboxd.exe

# generated project resource (rebuilt from gotbox.rc by the Makefile)
gotbox.res

# generated overlay-DLL resource + the built shell-extension DLL (win64)
gboxoverlay.res
GotBoxOverlay.dll

# built macOS Finder Sync extension bundle (packaging/macos/build-appex.sh)
GotBoxFinder.appex/

# console test binaries + their build dir. Matched by pattern, not listed one
# by one: a per-test list silently leaves every NEW test's binary untracked-but-
# visible until someone remembers to come back here.
/tests/test*
!/tests/test*.lpr
/tests/lib/
